# Vercel production (server-side only; never exposed to the browser)
GAS_WEB_APP_URL=
SUBMIT_SHARED_TOKEN=
TURNSTILE_SECRET_KEY=
PORTAL_BASE_URL=

# New backend (migration in progress). DATABASE_URL is Supabase's transaction
# pooler connection string; npm run db:migrate and db:seed read it from here.
# Leave CSM_BACKEND unset to keep Apps Script; set it to postgres at cutover.
DATABASE_URL=
CSM_BACKEND=

# The Apps Script worker (Worker.gs): certificates, emails, reports, uploads.
# The URL defaults to GAS_WEB_APP_URL; the token comes from setupCsmWorker().
CSM_WORKER_URL=
CSM_WORKER_TOKEN=

# Exposed to the browser at build time
VITE_TURNSTILE_SITE_KEY=

# Local Vite development only
VITE_GAS_WEB_APP_URL=
VITE_USE_PROXY=false
VITE_ENABLE_DEMO_MODE=false
